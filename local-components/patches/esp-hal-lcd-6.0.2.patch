+#define MIPI_DSI_READ_TIMEOUT_US 100000U
+static bool mipi_dsi_read_timed_out;
+
+bool mipi_dsi_hal_host_gen_read_timed_out(void)
+{
+    return mipi_dsi_read_timed_out;
+}
+
+/* One budget covers both command writes, BTA completion and FIFO reception.
+ * The caller must serialize reads on the single DSI bus. Panel ID and VCOM OTP
+ * probes run during startup, before application tasks start; the LCD abstraction
+ * consumes the status immediately after each probe. */
+static bool mipi_dsi_hal_read_poll(uint32_t *remaining_us)
+{
+    if (*remaining_us == 0) {
+        mipi_dsi_read_timed_out = true;
+        return false;
+    }
+    --*remaining_us;
+    esp_rom_delay_us(1);
+    return true;
+}
